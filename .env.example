# -----------------------------------------------------------------------------
# JARVIS secrets. Copy to `.env` and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Everything that is not a secret lives in config.yaml.
# -----------------------------------------------------------------------------

# REQUIRED for the brain (milestone 3 onwards). Milestones 1 and 2 run without
# it — the health check will simply report the key as missing.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL. Only needed if you set `tts.engine: elevenlabs` in config.yaml.
# Leaving this blank keeps JARVIS fully offline for speech.
ELEVENLABS_API_KEY=

# OPTIONAL. Point at a non-default Anthropic endpoint (proxy, gateway).
# Leave blank to use the public API.
ANTHROPIC_BASE_URL=

# OPTIONAL. Override the config file location.
# JARVIS_CONFIG=/path/to/config.yaml

# OPTIONAL. Override the log level without editing config.yaml.
# Useful for a one-off debugging run: JARVIS_LOG_LEVEL=DEBUG python -m jarvis
# JARVIS_LOG_LEVEL=INFO
